# Database connection URL (MySQL 8.0 with PyMySQL driver)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/insight_db

# Secret key used for signing JWT access tokens (use a cryptographically secure random string in production)
SECRET_KEY=replace-this-placeholder-secret

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend origin allowed for CORS requests
FRONTEND_URL=http://localhost:5173

# Optional AI Provider Configuration (used for AI question generation & answer evaluation)
# The application, unit tests, and database run without an AI key; only live generation/evaluation requires it.
AI_PROVIDER=openai_compatible
AI_API_KEY=your-provider-api-key-here
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions
